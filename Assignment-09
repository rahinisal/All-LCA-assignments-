#include <stdio.h>
#include <stdlib.h>

int main() {
    char file1[256], file2[256];
    FILE *src, *dest;
    int ch;

    printf("Enter the source file name (file1.txt): ");
    if (scanf("%s", file1) != 1) {
        fprintf(stderr, "Invalid input for source file name.\n");
        return 1;
    }

    printf("Enter the destination file name (file2.txt): ");
    if (scanf("%s", file2) != 1) {
        fprintf(stderr, "Invalid input for destination file name.\n");
        return 1;
    }

    src = fopen(file1, "r");
    if (src == NULL) {
        perror("Error opening source file");
        return 1;
    }

    dest = fopen(file2, "w");
    if (dest == NULL) {
        perror("Error opening destination file");
        fclose(src);
        return 1;
    }

    while ((ch = fgetc(src)) != EOF) {
        fputc(ch, dest);
    }

    if (ferror(src)) {
        perror("Error reading from source file");
        fclose(src);
        fclose(dest);
        return 1;
    }

    printf("File copied successfully from '%s' to '%s'.\n", file1, file2);

    fclose(src);
    fclose(dest);

    return 0;
}
